      <Placemark>
        <name>旅館街への導線</name>
        <styleUrl>#poly-FFEA00-1200-76</styleUrl>
        <ExtendedData>
          <Data name="id">
            <value>801cdd34-c7ac-5fef-a00f-6c8b9d5bbc7b</value>
          </Data>
          <Data name="key">
            <value>location_006</value>
          </Data>
          <Data name="address">
            <value />
          </Data>
          <Data name="instruction">
            <value>リフトAを使って降りるように案内。16:00 くらいを目標に降りるようにしましょう。</value>
          </Data>
          <Data name="description">
            <value />
          </Data>
        </ExtendedData>
        <Polygon>
          <outerBoundaryIs>
            <LinearRing>
              <tessellate>1</tessellate>
              <coordinates>
                134.545733,35.406671,0
